{
  "name": "zolttran",
  "displayName": "Zolttran — AI Game Studio",
  "description": "Hayalindeki oyunu gerçeğe dönüştür. 25 AI sağlayıcı, Godot 4.x entegrasyonu ve cross-platform deploy ile tam AI destekli oyun geliştirme platformu.",
  "version": "0.0.4",
  "publisher": "zolttran",
  "license": "Apache-2.0",
  "icon": "resources/icons/zolttran-icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/zolttran/zolttran"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI",
    "Other",
    "Programming Languages"
  ],
  "keywords": [
    "ai",
    "game-development",
    "godot",
    "openrouter",
    "anthropic",
    "openai",
    "multi-agent",
    "game-engine",
    "zolttran",
    "game-studio"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "zolttran.openPanel",
        "title": "Zolttran: Paneli Aç",
        "category": "Zolttran",
        "icon": "$(gamepad)"
      },
      {
        "command": "zolttran.newGame",
        "title": "Zolttran: Yeni Oyun",
        "category": "Zolttran",
        "icon": "$(add)"
      },
      {
        "command": "zolttran.buildAll",
        "title": "Zolttran: Tüm Platformlara Build",
        "category": "Zolttran",
        "icon": "$(package)"
      },
      {
        "command": "zolttran.runPreview",
        "title": "Zolttran: Canlı Önizleme",
        "category": "Zolttran",
        "icon": "$(play)"
      },
      {
        "command": "zolttran.openSettings",
        "title": "Zolttran: Provider Ayarları",
        "category": "Zolttran",
        "icon": "$(settings-gear)"
      },
      {
        "command": "zolttran.toggleFreeMode",
        "title": "Zolttran: FREE MODE Aç/Kapat",
        "category": "Zolttran"
      },
      {
        "command": "zolttran.openMemoryBank",
        "title": "Zolttran: Hafıza Bankasını Aç",
        "category": "Zolttran"
      },
      {
        "command": "zolttran.runGodotBridge",
        "title": "Zolttran: Godot Bridge Bağlan",
        "category": "Zolttran"
      },
      {
        "command": "zolttran.deployPlatform",
        "title": "Zolttran: Platforma Deploy",
        "category": "Zolttran"
      },
      {
        "command": "zolttran.showAgentPanel",
        "title": "Zolttran: Agent Panelini Göster",
        "category": "Zolttran"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "zolttran",
          "title": "Zolttran",
          "icon": "resources/icons/zolttran.svg"
        }
      ]
    },
    "views": {
      "zolttran": [
        {
          "type": "webview",
          "id": "zolttran.mainPanel",
          "name": "Zolttran Studio"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "zolttran.newGame",
          "when": "view == zolttran.mainPanel",
          "group": "navigation"
        },
        {
          "command": "zolttran.runPreview",
          "when": "view == zolttran.mainPanel",
          "group": "navigation"
        },
        {
          "command": "zolttran.openSettings",
          "when": "view == zolttran.mainPanel",
          "group": "navigation"
        }
      ],
      "editor/title": [
        {
          "command": "zolttran.openPanel",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "zolttran.openPanel",
        "key": "ctrl+shift+z",
        "mac": "cmd+shift+z"
      },
      {
        "command": "zolttran.newGame",
        "key": "ctrl+shift+n",
        "mac": "cmd+shift+n",
        "when": "zolttran.active"
      },
      {
        "command": "zolttran.runPreview",
        "key": "f5",
        "when": "zolttran.active"
      },
      {
        "command": "zolttran.buildAll",
        "key": "ctrl+shift+b",
        "mac": "cmd+shift+b",
        "when": "zolttran.active"
      }
    ],
    "configuration": {
      "title": "Zolttran",
      "properties": {
        "zolttran.freeMode": {
          "type": "boolean",
          "default": true,
          "description": "Ücretsiz AI modellerini otomatik rotasyonla kullan"
        },
        "zolttran.defaultProvider": {
          "type": "string",
          "default": "openrouter",
          "enum": [
            "openrouter",
            "nvidia",
            "anthropic",
            "openai",
            "google",
            "deepseek",
            "groq",
            "mistral",
            "xai",
            "cohere",
            "cerebras",
            "poolside",
            "qwen",
            "ollama",
            "lmstudio",
            "huggingface",
            "sambanova",
            "siliconflow",
            "cloudflare",
            "github",
            "modelscope",
            "nebius",
            "zai",
            "kilo",
            "custom"
          ],
          "description": "Varsayılan AI provider"
        },
        "zolttran.defaultModel": {
          "type": "string",
          "default": "auto",
          "description": "Varsayılan model ID (auto = akıllı yönlendirme)"
        },
        "zolttran.godotPath": {
          "type": "string",
          "default": "",
          "description": "Godot 4 çalıştırılabilir dosyasının yolu"
        },
        "zolttran.godotBridgePort": {
          "type": "number",
          "default": 9876,
          "description": "Godot MCP/TCP köprüsü için port"
        },
        "zolttran.orchestratorMode": {
          "type": "string",
          "default": "orchestrator",
          "enum": [
            "architect",
            "code",
            "debug",
            "ask",
            "orchestrator"
          ],
          "description": "Varsayılan orchestrator modu"
        },
        "zolttran.maxParallelAgents": {
          "type": "number",
          "default": 3,
          "minimum": 1,
          "maximum": 10,
          "description": "Aynı anda çalışabilecek maksimum agent sayısı"
        },
        "zolttran.autoApprove": {
          "type": "string",
          "default": "ask",
          "enum": [
            "auto",
            "ask",
            "never"
          ],
          "description": "Dosya yazma / ağ / komut onay modu"
        },
        "zolttran.livePreviewPort": {
          "type": "number",
          "default": 8080,
          "description": "Canlı oyun önizleme sunucusu portu"
        },
        "zolttran.locale": {
          "type": "string",
          "default": "tr",
          "enum": [
            "en",
            "tr"
          ],
          "description": "Arayüz dili"
        },
        "zolttran.telemetry": {
          "type": "boolean",
          "default": false,
          "description": "Anonim kullanım istatistikleri gönder"
        },
        "zolttran.autoOpenPanel": {
          "type": "boolean",
          "default": false,
          "description": "VS Code açıldığında Zolttran panelini otomatik aç"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "npm run build:ext && npm run build:ui",
    "build:ext": "node node_modules/esbuild/bin/esbuild src/extension.ts --bundle --outfile=dist/extension.js --platform=node --target=node20 --external:vscode --sourcemap --log-level=warning",
    "build:ui": "node node_modules/vite/bin/vite.js build --config vite.config.ts",
    "dev:ext": "node node_modules/esbuild/bin/esbuild src/extension.ts --bundle --outfile=dist/extension.js --platform=node --target=node20 --external:vscode --sourcemap --watch",
    "dev:ui": "node node_modules/vite/bin/vite.js build --config vite.config.ts --watch",
    "test": "jest",
    "lint": "eslint src --ext ts,tsx --max-warnings 0",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/vscode": "^1.90.0",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vscode/vsce": "^3.0.0",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.23.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "postcss": "^8.4.47",
    "prettier": "^3.3.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.5.0",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "@types/semver": "^7.5.8",
    "eventsource-parser": "^2.0.0",
    "framer-motion": "^11.5.0",
    "idb": "^8.0.0",
    "lucide-react": "^0.447.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-markdown": "^9.0.0",
    "rehype-highlight": "^7.0.0",
    "remark-gfm": "^4.0.0",
    "semver": "^7.6.0",
    "three": "^0.169.0",
    "ws": "^8.18.0",
    "zustand": "^4.5.0"
  }
}
